# ============================================================
# ScholarMind 环境变量配置
# 
# 使用方法:
# 1. 复制本文件为 .env:  copy .env.example .env
# 2. 填入你的真实 API Key
# 3. 确认 .env 已被 .gitignore 排除 (绝不提交!)
# ============================================================

# [必需] MiniMax API Key
# 获取方式: https://platform.minimaxi.com/
MINIMAX_API_KEY=你的key

# [可选] MiniMax API 基础 URL
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# [可选] MiniMax 模型名称
# 文本模型: MiniMax-M3（默认，上下文 1M，支持 text/image/video，thinking adaptive/disabled）
#           也可换 MiniMax-M2.7（上下文 200K，纯文本，thinking always_on）
MINIMAX_MODEL=MiniMax-M3


# [可选] MiniMax Vision 模型（独立于 MINIMAX_MODEL，避免 KG 切模型时图表分析静默变瞎）
# 默认 MiniMax-M3（支持 image/video 输入模态）
MINIMAX_VISION_MODEL=MiniMax-M3


# [可选] 成本控制
MAX_TOKENS_PER_SESSION=50000


# ============================================================
# Notion 同步（src.recorder 使用）
# ============================================================
# [可选] Notion integration token
# 获取方式: https://www.notion.so/profile/integrations
NOTION_API_KEY=

# [可选] 父页面定位（任选其一）
# - NOTION_PARENT_PAGE_ID: 直接给 page UUID
# - NOTION_PARENT_PAGE_NAME: 按名称在 Notion search 中查找（结果缓存到 data/recorder_state/_parent.json）
NOTION_PARENT_PAGE_ID=
NOTION_PARENT_PAGE_NAME=ACADEMICAGENT_v2

# [可选] Notion API 版本
NOTION_VERSION=2022-06-28
