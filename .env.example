# ============================================================
# ScholarMind 环境变量配置
# 
# 使用方法:
# 1. 复制本文件为 .env:  copy .env.example .env
# 2. 填入你的真实 API Key
# 3. 确认 .env 已被 .gitignore 排除 (绝不提交!)
# ============================================================

# [必需] MiniMax API Key
# 获取方式: https://platform.minimaxi.com/
MINIMAX_API_KEY=你的key

# [Optional] MiniMax OpenAI-compatible API base URL
# Global: https://api.minimax.io/v1
# China:  https://api.minimaxi.com/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1

# [Optional] MiniMax text model
# MiniMax-M3.1-Flash is the default: 1M context, adaptive-only thinking.
# MiniMax-M3 is the alternative: 1M context, adaptive or disabled thinking.
# Explicit saved/custom model IDs remain supported.
MINIMAX_MODEL=MiniMax-M3.1-Flash


# [Optional] MiniMax vision model, independent from MINIMAX_MODEL
# MiniMax-M3 supports image and video input.
MINIMAX_VISION_MODEL=MiniMax-M3


# [可选] 成本控制
MAX_TOKENS_PER_SESSION=50000


# ============================================================
# Notion 同步（src.recorder 使用）
# ============================================================
# [可选] Notion integration token
# 获取方式: https://www.notion.so/profile/integrations
NOTION_API_KEY=

# [可选] 父页面定位（任选其一）
# - NOTION_PARENT_PAGE_ID: 直接给 page UUID
# - NOTION_PARENT_PAGE_NAME: 按名称在 Notion search 中查找（结果缓存到 data/recorder_state/_parent.json）
NOTION_PARENT_PAGE_ID=
NOTION_PARENT_PAGE_NAME=ACADEMICAGENT_v2

# [可选] Notion API 版本
NOTION_VERSION=2022-06-28
